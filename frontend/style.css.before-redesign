/* ENERCloud dashboard - graphite control-room theme */
:root {
  --bg: #15171a;
  --panel: #1b1e22;
  --panel-raised: #21252a;
  --line: #2c3137;
  --line-strong: #3a4047;
  --text: #ece7de;
  --muted: #9aa1a9;
  --faint: #6c737b;
  --amber: #e2a33c;
  --amber-soft: rgba(226, 163, 60, 0.16);
  --red: #e5574e;
  --red-soft: rgba(229, 87, 78, 0.1);
  --red-line: rgba(229, 87, 78, 0.45);
  --green: #62ad80;
  --green-soft: rgba(98, 173, 128, 0.14);
  --sans: "IBM Plex Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
  --mono: "IBM Plex Mono", ui-monospace, "SF Mono", Menlo, monospace;
  --ease: cubic-bezier(0.2, 0.7, 0.2, 1);
  color-scheme: dark;
}

* { box-sizing: border-box; }
html { background: var(--bg); }
body {
  margin: 0; color: var(--text); background: var(--bg);
  font-family: var(--sans); font-size: 15px; line-height: 1.5;
  -webkit-font-smoothing: antialiased; font-variant-numeric: tabular-nums;
}
h1, h2, p { margin: 0; }
h2 { font-size: 0.95rem; font-weight: 600; letter-spacing: 0.01em; }
.muted { color: var(--muted); }
.small { font-size: 0.82rem; }
.num { text-align: right; }

/* ---------------------------------------------------------------- top bar */
.topbar {
  display: flex; align-items: center; justify-content: space-between; gap: 16px 32px; flex-wrap: wrap;
  padding: 14px clamp(16px, 4vw, 40px); border-bottom: 1px solid var(--line);
  position: sticky; top: 0; z-index: 5; background: rgba(21, 23, 26, 0.92); backdrop-filter: blur(8px);
}
.wordmark { display: flex; align-items: center; gap: 10px; }
.wordmark__mark { width: 18px; height: 18px; fill: var(--amber); }
.wordmark__name { font-weight: 600; font-size: 1.05rem; letter-spacing: 0.02em; }
.wordmark__tag { color: var(--faint); font-size: 0.85rem; padding-left: 12px; border-left: 1px solid var(--line-strong); }
.topbar__right { display: flex; align-items: center; gap: 28px; flex-wrap: wrap; }

.conn { display: inline-flex; align-items: center; gap: 8px; font-size: 0.85rem; font-weight: 500;
        padding: 4px 12px 4px 10px; border: 1px solid var(--line-strong); border-radius: 999px;
        transition: border-color 0.3s var(--ease), color 0.3s var(--ease); }
.conn__dot { width: 7px; height: 7px; border-radius: 50%; background: var(--amber); }
.conn[data-state="live"] { border-color: rgba(98, 173, 128, 0.5); color: var(--green); }
.conn[data-state="live"] .conn__dot { background: var(--green); animation: pulse 2.4s ease-out infinite; }
.conn[data-state="error"] { border-color: var(--red-line); color: var(--red); }
.conn[data-state="error"] .conn__dot { background: var(--red); }
.conn[data-state="mock"] { color: var(--amber); border-color: rgba(226, 163, 60, 0.4); }
@keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(98, 173, 128, 0.5); } 70%, 100% { box-shadow: 0 0 0 6px rgba(98, 173, 128, 0); } }

.topmeta { display: flex; gap: 24px; margin: 0; }
.topmeta div { display: flex; flex-direction: column; }
.topmeta dt { color: var(--faint); font-size: 0.72rem; }
.topmeta dd { margin: 0; font-family: var(--mono); font-size: 0.85rem; }

.notice { padding: 10px clamp(16px, 4vw, 40px); font-size: 0.88rem; color: var(--amber);
          background: var(--amber-soft); border-bottom: 1px solid rgba(226, 163, 60, 0.3); }
.notice--error { color: var(--red); background: var(--red-soft); border-bottom-color: var(--red-line); }

main { max-width: 1240px; margin: 0 auto; padding: 0 clamp(16px, 4vw, 40px) 64px; }

/* ---------------------------------------------------------------- overview */
.overview { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 40px;
            padding: 40px 0 32px; border-bottom: 1px solid var(--line); align-items: end; }
.label { font-size: 0.9rem; font-weight: 500; color: var(--muted); }
.load__value { display: flex; align-items: baseline; gap: 12px; margin: 6px 0 22px; }
#total-kw { font-size: clamp(3.6rem, 9vw, 6.2rem); font-weight: 600; line-height: 0.95; letter-spacing: -0.035em; }
.load__unit { font-size: 1.4rem; color: var(--muted); font-weight: 500; }

.mix { display: flex; height: 8px; gap: 2px; background: var(--panel); border-radius: 2px; overflow: hidden; }
.mix span { height: 100%; background: var(--amber); transition: flex-grow 0.7s var(--ease), background-color 0.3s; }
.mix span.is-anomaly { background: var(--red); }
.mix-legend { list-style: none; padding: 0; margin: 10px 0 0; display: flex; flex-wrap: wrap; gap: 4px 18px;
              font-size: 0.8rem; color: var(--muted); }
.mix-legend b { font-family: var(--mono); font-weight: 500; color: var(--text); margin-left: 6px; }
.mix-legend li.is-anomaly b { color: var(--red); }

.summary { display: grid; grid-template-columns: repeat(2, 1fr); margin: 0; border-top: 1px solid var(--line); }
.summary div { padding: 14px 0 14px 18px; border-bottom: 1px solid var(--line); border-left: 1px solid var(--line); }
.summary div:nth-child(odd) { border-left: none; padding-left: 0; }
.summary dt { color: var(--muted); font-size: 0.82rem; }
.summary dd { margin: 2px 0 0; font-size: 2rem; font-weight: 600; letter-spacing: -0.02em; line-height: 1.15; }
.summary__anomalies.has-alerts dd { color: var(--red); }

/* ---------------------------------------------------------------- alerts */
.alerts { display: grid; gap: 12px; margin-top: 28px; }
.all-clear { display: flex; align-items: center; gap: 10px; color: var(--muted); font-size: 0.9rem; }
.all-clear::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--green); }
.alert { display: grid; grid-template-columns: minmax(0, 1.2fr) repeat(3, minmax(0, 1fr)); gap: 24px; align-items: end;
         padding: 18px 22px; background: var(--red-soft); border: 1px solid var(--red-line); border-left: 3px solid var(--red); }
.alert.is-new { animation: alert-in 0.45s var(--ease); }
@keyframes alert-in { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: none; } }
.alert__title { color: var(--red); font-size: 0.8rem; font-weight: 600; letter-spacing: 0.06em; }
.alert__title time { color: var(--muted); font-weight: 400; letter-spacing: 0; margin-left: 8px; font-family: var(--mono); }
.alert__building { font-size: 1.15rem; font-weight: 600; margin-top: 4px; }
.alert__building small { color: var(--muted); font-weight: 400; font-size: 0.85rem; margin-left: 8px; font-family: var(--mono); }
.alert__fact dt { color: var(--muted); font-size: 0.78rem; }
.alert__fact dd { margin: 2px 0 0; font-family: var(--mono); font-size: 1.05rem; }
.alert__fact--power dd { font-family: var(--sans); color: var(--red); font-size: 1.9rem; font-weight: 600; letter-spacing: -0.02em; line-height: 1; }
.alert dl { margin: 0; }

/* ---------------------------------------------------------------- panels */
.panel { margin-top: 36px; }
.panel__head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; flex-wrap: wrap;
               padding-bottom: 12px; border-bottom: 1px solid var(--line); }
.key { list-style: none; display: flex; gap: 18px; padding: 0; margin: 0; font-size: 0.78rem; color: var(--muted); flex-wrap: wrap; }
.key li { display: flex; align-items: center; gap: 6px; }
.key__band { width: 16px; height: 8px; background: var(--green-soft); border: 1px solid rgba(98, 173, 128, 0.35); }
.key__limit { width: 2px; height: 12px; background: var(--red); }
.key__fill { width: 16px; height: 4px; background: var(--amber); }

/* meters */
.meter { display: grid; grid-template-columns: 220px minmax(0, 1fr) 110px 104px; gap: 24px; align-items: center;
         padding: 16px 12px 16px 14px; border-bottom: 1px solid var(--line); border-left: 2px solid transparent;
         transition: background-color 0.25s var(--ease), border-color 0.25s var(--ease); }
.meter:hover { background: var(--panel); }
.meter.is-anomaly { background: var(--red-soft); border-left-color: var(--red); }
.meter__name { font-weight: 500; }
.meter__sub { display: block; font-family: var(--mono); font-size: 0.75rem; color: var(--faint); margin-top: 2px; }
.gauge { position: relative; height: 22px; }
.gauge__track { position: absolute; left: 0; right: 0; top: 10px; height: 2px; background: var(--line-strong); }
.gauge__band { position: absolute; top: 5px; height: 12px; background: var(--green-soft); border: 1px solid rgba(98, 173, 128, 0.3); }
.gauge__fill { position: absolute; left: 0; top: 9px; height: 4px; width: 0; background: var(--amber);
               transition: width 0.7s var(--ease), background-color 0.3s; }
.is-anomaly .gauge__fill { background: var(--red); }
.gauge__limit { position: absolute; top: 0; bottom: 0; width: 2px; background: var(--red); }
.gauge__limit::after { content: attr(data-label); position: absolute; top: 24px; left: 50%; transform: translateX(-50%);
                       font-family: var(--mono); font-size: 0.68rem; color: var(--faint); white-space: nowrap; }
.meter__kw { text-align: right; font-size: 1.5rem; font-weight: 600; letter-spacing: -0.02em; }
.meter__kw small { font-size: 0.8rem; color: var(--muted); font-weight: 500; margin-left: 4px; }
.is-anomaly .meter__kw { color: var(--red); }

/* status badges: shape + text, never colour alone */
.badge { display: inline-flex; align-items: center; gap: 6px; font-size: 0.8rem; font-weight: 600; white-space: nowrap; }
.badge::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
.badge--NORMAL { color: var(--green); }
.badge--ANOMALY { color: var(--red); }
.badge--ANOMALY::before { border-radius: 0; width: 0; height: 0; background: none;
                          border-left: 5px solid transparent; border-right: 5px solid transparent; border-bottom: 8px solid currentColor; }
.badge--NODATA { color: var(--faint); }

/* ---------------------------------------------------------------- tables */
.logs { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 32px; }
.table-wrap { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; font-size: 0.86rem; }
th { text-align: left; font-weight: 500; color: var(--faint); font-size: 0.76rem; padding: 10px 10px; border-bottom: 1px solid var(--line); white-space: nowrap; }
td { padding: 9px 10px; border-bottom: 1px solid var(--line); vertical-align: top; }
td.mono { font-family: var(--mono); font-size: 0.82rem; }
td.num { font-family: var(--mono); font-size: 0.82rem; white-space: nowrap; }
td.time { font-family: var(--mono); font-size: 0.8rem; color: var(--muted); white-space: nowrap; }
tbody tr { transition: background-color 0.15s; }
tbody tr:hover { background: var(--panel); }
tbody tr.is-anomaly { background: var(--red-soft); box-shadow: inset 2px 0 0 var(--red); }
tbody tr.is-anomaly td.num:nth-last-child(2) { color: var(--red); }
tbody tr.empty td { color: var(--faint); font-style: italic; padding: 20px 10px; }
.rule { display: block; color: var(--text); }
.rule b { color: var(--red); font-weight: 600; margin-right: 6px; }
.rule + .rule { margin-top: 3px; }

/* ---------------------------------------------------------------- ops */
.ops { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 32px; margin-top: 44px; align-items: start; }
.export { display: grid; grid-template-columns: 1fr auto; gap: 14px 24px; align-items: center;
          padding: 20px 22px; background: var(--panel); border: 1px solid var(--line); }
.export p { font-size: 0.86rem; margin-top: 2px; }
.export__msg { grid-column: 1 / -1; font-size: 0.86rem; }
.export__msg:empty { display: none; }
.export__msg.is-success { padding: 10px 12px; background: var(--green-soft); border: 1px solid rgba(98, 173, 128, 0.35); color: var(--green); }
.export__msg.is-error { color: var(--red); }
.export__msg code { display: block; margin-top: 4px; font-family: var(--mono); font-size: 0.8rem; color: var(--text); word-break: break-all; }

.btn { font: inherit; font-size: 0.88rem; font-weight: 600; padding: 10px 18px; min-height: 42px; cursor: pointer;
       border-radius: 3px; border: 1px solid transparent; transition: background-color 0.15s, transform 0.08s, border-color 0.15s; }
.btn:active { transform: translateY(1px); }
.btn--primary { background: var(--amber); color: #1a1408; }
.btn--primary:hover { background: #ecb352; }
.btn--ghost { background: transparent; color: var(--text); border-color: var(--line-strong); }
.btn--ghost:hover { border-color: var(--muted); }
.btn:disabled { opacity: 0.55; cursor: progress; transform: none; }
.btn:focus-visible, input:focus-visible, summary:focus-visible { outline: 2px solid var(--amber); outline-offset: 2px; }

.settings { background: var(--panel); border: 1px solid var(--line); padding: 16px 20px; }
.settings summary { cursor: pointer; font-weight: 600; font-size: 0.95rem; }
.settings[open] summary { margin-bottom: 14px; }
.settings label { display: block; color: var(--muted); font-size: 0.8rem; margin-bottom: 6px; }
.settings input { width: 100%; padding: 10px 12px; font-family: var(--mono); font-size: 0.82rem; color: var(--text);
                  background: var(--bg); border: 1px solid var(--line-strong); border-radius: 3px; }
.settings .small { margin-top: 8px; }
.settings__buttons { display: flex; gap: 10px; margin-top: 14px; flex-wrap: wrap; }

/* ---------------------------------------------------------------- responsive */
@media (max-width: 1000px) {
  .overview, .logs, .ops { grid-template-columns: minmax(0, 1fr); }
  .alert { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .alert > :first-child { grid-column: 1 / -1; }
}
@media (max-width: 720px) {
  .meter { grid-template-columns: minmax(0, 1fr) auto; row-gap: 10px; padding-bottom: 26px; }
  .gauge { grid-column: 1 / -1; grid-row: 2; }
  .meter .badge { grid-column: 2; grid-row: 3; justify-self: end; }
  .wordmark__tag { display: none; }
  .topbar { position: static; }
  .export { grid-template-columns: 1fr; }
  .summary dd { font-size: 1.6rem; }
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation: none !important; transition: none !important; }
}
